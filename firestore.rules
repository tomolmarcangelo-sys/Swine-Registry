rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Swine registry records collection
    match /pigs/{pigId} {
      allow read, write: if true;
    }
    
    // System users & focal officers collection
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Field sync logs audit trail
    match /syncLogs/{logId} {
      allow read, write: if true;
    }
  }
}
