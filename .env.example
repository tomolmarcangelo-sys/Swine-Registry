# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# 1. Supabase (PostgreSQL + PostGIS & Prisma ORM)
# ==============================================================================
# Connection Pooling (Supavisor Transaction Mode, Port 6543) for API operations
DATABASE_URL="postgresql://postgres.lpkquznudtqrpuzmwhdt:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) for Schema Migrations
DIRECT_URL="postgresql://postgres.lpkquznudtqrpuzmwhdt:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase API URL and keys from Project Settings -> API
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==============================================================================
# 2. Render (Backend Node.js API Service)
# ==============================================================================
PORT="10000"
# Live URL of your deployed Render Web Service
